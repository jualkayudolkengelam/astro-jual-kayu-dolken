---
import Base from '../layouts/Base.astro';
import { cities, regions } from '../data/cities';
import { site, waLink } from '../data/site';
import { homeDates, formatTanggalId } from '../lib/dates.js';

const halamanUtama = [
  { href: '/', label: 'Beranda', desc: 'Halaman utama — info harga, produk, layanan, dan kontak.' },
  { href: '/jual-kayu-dolken-terdekat/', label: 'Jual Kayu Dolken Terdekat', desc: 'Cari penjual kayu dolken terdekat dari lokasi Anda.' },
  { href: '/sitemap/', label: 'Sitemap (halaman ini)', desc: 'Daftar lengkap semua halaman situs.' },
];

const groupCities = (regi: string) => cities.filter((c) => c.region === regi);
const adaKota = regions.filter((r) => groupCities(r.name).length > 0);
---

<Base
  title={`Sitemap — Daftar Semua Halaman | ${site.name}`}
  description="Daftar lengkap semua halaman situs Jual Kayu Dolken Gelam — halaman utama, halaman kota, dan informasi kontak."
  dateCreated={homeDates.created}
  dateUpdated={homeDates.updated}
>
  <main class="mx-auto w-full max-w-3xl px-4 py-10">
    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-wood-500">Sitemap</p>
      <h1 class="mt-1 text-3xl font-bold text-stone-800">Daftar Semua Halaman</h1>
      <p class="mt-2 text-sm text-stone-500">
        {cities.length + halamanUtama.length} halaman · terakhir diperbarui {formatTanggalId(homeDates.updated)}
      </p>
    </header>

    <section class="mb-10">
      <h2 class="mb-3 text-lg font-semibold text-stone-800">Halaman Utama</h2>
      <ul class="grid gap-2">
        {
          halamanUtama.map((h) => (
            <li class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
              <a href={h.href} class="font-medium text-wood-600 hover:text-wood-700 hover:underline">
                {h.label}
              </a>
              <p class="mt-0.5 text-xs text-stone-500">{h.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      adaKota.map((r) => {
        const kota = groupCities(r.name);
        return (
          <section class="mb-10">
            <h2 class="mb-1 text-lg font-semibold text-stone-800">{r.name}</h2>
            <p class="mb-3 text-sm text-stone-500">{r.blurb}</p>
            <ul class="grid gap-2 sm:grid-cols-2">
              {kota.map((c) => (
                <li class="rounded-lg border border-stone-200 bg-white p-3 shadow-sm">
                  <a
                    href={`/kayu-dolken-${c.slug}/`}
                    class="text-sm font-medium text-wood-600 hover:text-wood-700 hover:underline"
                  >
                    Kayu Dolken {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <section class="rounded-xl bg-wood-50 p-6 text-center">
      <h2 class="text-lg font-semibold text-stone-800">Tidak menemukan kota Anda?</h2>
      <p class="mt-1 text-sm text-stone-600">
        Kami melayani pengiriman ke seluruh Pulau Jawa dan Sulawesi. Hubungi kami untuk info lebih lanjut.
      </p>
      <a
        href={waLink()}
        class="mt-3 inline-block rounded-full bg-wood-600 px-6 py-2 text-sm font-semibold text-white hover:bg-wood-700"
      >
        Chat WhatsApp
      </a>
    </section>
  </main>
</Base>