---
import Base from '../layouts/Base.astro';
import { cities, regions } from '../data/cities';
import { site, waLink } from '../data/site';
import { homeDates, terdekatDates, cityPageDates, formatTanggalId } from '../lib/dates.js';

const regionNama = new Map(regions.map((r) => [r.name, r.blurb]));

const halamanUtama = [
  { href: '/', label: 'Beranda', region: null, dates: homeDates },
  { href: '/jual-kayu-dolken-terdekat/', label: 'Jual Kayu Dolken Terdekat', region: null, dates: terdekatDates },
  { href: '/sitemap/', label: 'Sitemap', region: null, dates: homeDates },
];

const halamanKota = cities.map((c) => ({
  href: `/kayu-dolken-${c.slug}/`,
  label: `Kayu Dolken ${c.name}`,
  region: c.region,
  dates: cityPageDates(c.slug),
}));

const semua = [...halamanKota, ...halamanUtama];
const olehTanggal = (a, b) => (a.dates.updated < b.dates.updated ? 1 : -1);
const terbaru = [...semua].sort(olehTanggal);
const terakhirUpdate = [...semua].map((p) => p.dates.updated).sort().pop();
---

<Base
  title={`Sitemap — Daftar Semua Halaman | ${site.name}`}
  description="Daftar lengkap semua halaman situs Jual Kayu Dolken Gelam — halaman utama, halaman kota, dan informasi kontak."
  dateCreated={homeDates.created}
  dateUpdated={terakhirUpdate}
>
  <main class="mx-auto w-full max-w-3xl px-4 py-10">
    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-wood-500">Sitemap</p>
      <h1 class="mt-1 text-3xl font-bold text-stone-800">Daftar Semua Halaman</h1>
      <p class="mt-2 text-sm text-stone-500">
        {cities.length + halamanUtama.length} halaman · terakhir diperbarui {formatTanggalId(terakhirUpdate)}
      </p>
    </header>

    <section class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-lg font-semibold text-stone-800">Konten Terbaru</h2>
        <span class="rounded-full bg-wood-100 px-2 py-0.5 text-xs font-medium text-wood-700">terbaru dulu</span>
      </div>
      <ol class="space-y-2">
        {
          terbaru.map((p, i) => (
            <li class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
              <div class="flex items-baseline justify-between gap-3">
                <a href={p.href} class="font-medium text-wood-600 hover:text-wood-700 hover:underline">
                  {p.label}
                </a>
                <span class="shrink-0 text-xs text-stone-400">{formatTanggalId(p.dates.updated)}</span>
              </div>
              {
                p.region && (
                  <p class="mt-1 text-xs text-stone-500">{p.region}</p>
                )
              }
            </li>
          ))
        }
      </ol>
    </section>

    <section class="rounded-xl bg-wood-50 p-6 text-center">
      <h2 class="text-lg font-semibold text-stone-800">Tidak menemukan kota Anda?</h2>
      <p class="mt-1 text-sm text-stone-600">
        Kami melayani pengiriman ke seluruh Pulau Jawa dan Sulawesi. Hubungi kami untuk info lebih lanjut.
      </p>
      <a
        href={waLink()}
        class="mt-3 inline-block rounded-full bg-wood-600 px-6 py-2 text-sm font-semibold text-white hover:bg-wood-700"
      >
        Chat WhatsApp
      </a>
    </section>
  </main>
</Base>