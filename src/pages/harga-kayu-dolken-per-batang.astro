---
import Base from '../layouts/Base.astro';
import Pricing from '../components/Pricing.astro';
import { site, waLink, rupiah, products } from '../data/site';
import { hargaPerBatangDates, formatTanggalId } from '../lib/dates.js';

const cheapest = products[0].price;

const title = 'Harga Kayu Dolken Per Batang — Mulai ' + rupiah(cheapest);
const description = `Harga kayu dolken per batang terbaru: ${rupiah(products[0].price)} (ø ${products[0].size}), ${rupiah(products[1].price)} (ø ${products[1].size}), ${rupiah(products[2].price)} (ø ${products[2].size}), ${rupiah(products[3].price)} (ø ${products[3].size}). Panjang 4 m, COD, gratis ongkir se-Jawa. Telepon ${site.phones[0].label}.`;

const fotos = [
  { src: '/images/harga-kayu-dolken-per-batang/harga-kayu-dolken-per-batang-01.jpeg', alt: 'Harga Kayu Dolken Per Batang', caption: `Kayu dolken gelam diameter ${products[0].size} — harga ${rupiah(products[0].price)} per batang.` },
  { src: '/images/harga-kayu-dolken-per-batang/harga-kayu-dolken-per-batang-02.jpeg', alt: 'Harga Kayu Dolken Per Batang', caption: `Kayu dolken gelam diameter ${products[1].size} — harga ${rupiah(products[1].price)} per batang.` },
  { src: '/images/harga-kayu-dolken-per-batang/harga-kayu-dolken-per-batang-03.jpeg', alt: 'Harga Kayu Dolken Per Batang', caption: `Kayu dolken gelam diameter ${products[2].size} (terlaris) — harga ${rupiah(products[2].price)} per batang.` },
  { src: '/images/harga-kayu-dolken-per-batang/harga-kayu-dolken-per-batang-04.jpeg', alt: 'Harga Kayu Dolken Per Batang', caption: `Kayu dolken gelam diameter ${products[3].size} — harga ${rupiah(products[3].price)} per batang.` },
];

const faq = [
  {
    q: 'Berapa harga kayu dolken per batang yang paling murah?',
    a: `Harga termurah adalah ${rupiah(products[0].price)} per batang untuk diameter ${products[0].size} panjang 4 meter. Ukuran ini cocok untuk pagar sementara, ajir tanaman, atau kebutuhan dekorasi sederhana.`,
  },
  {
    q: 'Mengapa diameter 8–10 cm harganya paling laris?',
    a: `Diameter ${products[2].size} adalah ukuran serbaguna — cukup kuat untuk pondasi cerucuk rumah tinggal dan struktur ringan, tapi tidak semahal diameter ${products[3].size}. Rasio kekuatan dan harga membuatnya paling dicari tukang dan kontraktor.`,
  },
  {
    q: 'Apakah harga kayu dolken per batang sudah termasuk ongkos kirim?',
    a: 'Untuk semua kota di Pulau Jawa, ongkos kirim gratis tanpa minimum pembelian. Untuk luar Jawa (Sulawesi, Sumatra, Kalimantan), silakan hubungi kami — biasanya di atas juga gratis jika masuk rute armada yang sama.',
  },
  {
    q: 'Bagaimana cara memastikan kayu dolken yang saya beli berkualitas?',
    a: 'Setiap pengiriman kami sertakan dokumen legalitas resmi dari Dinas Kehutanan (SKSHL/SKTM). Kayu gelam Sumatera kami tumbuh di habitat rawa sehingga secara alami tahan air dan jamur. Saat barang tiba, Anda bisa periksa langsung kondisi kayu sebelum membayar.',
  },
];
---

<Base
  title={title}
  description={description}
  dateCreated={hargaPerBatangDates.created}
  dateUpdated={hargaPerBatangDates.updated}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-wood-900 text-white">
    <div
      class="absolute inset-0 opacity-20"
      style="background: radial-gradient(50rem 24rem at 80% -10%, #16a34a44, transparent), radial-gradient(40rem 22rem at 10% 120%, #c99a5f55, transparent);"
      aria-hidden="true">
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-16 text-center md:py-24">
      <p class="reveal mx-auto w-fit rounded-full border border-wood-700 bg-wood-800/60 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-wood-300">
        💰 Update Harga Terbaru
      </p>
      <h1 class="reveal mx-auto mt-5 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-5xl">
        Harga Kayu Dolken <span class="text-moss-400">Per Batang</span>
      </h1>
      <p class="reveal mx-auto mt-4 max-w-2xl leading-relaxed text-wood-100/90">
        Daftar harga kayu dolken gelam asli Sumatera per batang untuk 4 ukuran diameter —
        panjang standar 4 meter, bayar di tempat setelah barang tiba, gratis ongkos kirim ke
        seluruh Pulau Jawa.
      </p>
      <p class="reveal mt-3 text-xs font-medium text-wood-400">
        Terakhir diperbarui: {formatTanggalId(hargaPerBatangDates.updated)}
      </p>
      <div class="reveal mt-7 flex flex-wrap justify-center gap-3">
        <a href={`tel:${site.phones[0].tel}`} class="inline-flex items-center gap-2 rounded-xl bg-wood-100 px-6 py-3.5 font-bold text-wood-900 shadow-lg transition hover:-translate-y-0.5 hover:bg-white">
          ☎ Telepon {site.phones[0].label}
        </a>
        <a
          href={waLink('Halo, saya mau tanya harga kayu dolken per batang. Mohon info diameter dan jadwal pengiriman.')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-moss-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/20 transition hover:bg-moss-600 hover:-translate-y-0.5"
        >
          💬 WhatsApp Sekarang
        </a>
      </div>
    </div>
  </section>

  <!-- Info strip -->
  <section class="border-b border-wood-100 bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-wood-100 px-4 py-6 text-center sm:grid-cols-4 sm:divide-x">
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">Rp15rb+</p><p class="text-xs font-medium text-wood-500">per batang</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">Ø 4–12 cm</p><p class="text-xs font-medium text-wood-500">4 ukuran</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-moss-600">GRATIS</p><p class="text-xs font-medium text-wood-500">ongkir se-Jawa</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">COD</p><p class="text-xs font-medium text-wood-500">bayar ditempat</p></div>
    </div>
  </section>

  <Pricing />

  <!-- Galeri 4 foto -->
  <section id="galeri" class="scroll-mt-20 bg-wood-50 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <div class="reveal mx-auto mb-10 max-w-xl text-center">
        <h2 class="text-2xl font-extrabold tracking-tight text-wood-900 sm:text-3xl">
          Galeri Kayu Dolken Gelam
        </h2>
        <p class="mt-3 text-wood-600">
          Foto dokumentasi stok dan kondisi kayu dolken gelam Sumatera sebelum dikirim ke pelanggan —
          diameter 4–12 cm, panjang 4 meter, lurus dan kering.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          fotos.map((f) => (
            <figure class="reveal overflow-hidden rounded-2xl border border-wood-100 bg-white shadow-sm">
              <img
                src={f.src}
                alt={f.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <figcaption class="px-4 py-3 text-sm leading-relaxed text-wood-600">{f.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tabel ringkasan + faktor harga -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="reveal mb-4 text-2xl font-extrabold tracking-tight text-wood-900">
        Ringkasan Harga Kayu Dolken Per Batang
      </h2>
      <div class="reveal overflow-x-auto rounded-xl border border-wood-100">
        <table class="w-full min-w-[420px] text-left text-sm">
          <thead class="bg-wood-50 text-xs uppercase tracking-wide text-wood-500">
            <tr>
              <th class="px-4 py-3">Diameter</th>
              <th class="px-4 py-3">Panjang</th>
              <th class="px-4 py-3 text-right">Harga / Batang</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-wood-100 bg-white">
            {
              products.map((p) => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-wood-800">ø {p.size}</td>
                  <td class="px-4 py-3 text-wood-600">{p.length}</td>
                  <td class="px-4 py-3 text-right font-bold text-wood-900">{rupiah(p.price)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="reveal mt-8 mb-4 text-2xl font-extrabold tracking-tight text-wood-900">
        Faktor yang Mempengaruhi Harga Kayu Dolken Per Batang
      </h2>
      <div class="reveal space-y-3 leading-relaxed text-wood-600">
        <p>
          Harga kayu dolken per batang ditentukan oleh tiga faktor utama:
          <strong class="text-wood-800">diameter</strong>,
          <strong class="text-wood-800">panjang</strong>, dan
          <strong class="text-wood-800">jarak pengiriman</strong>.
          Diameter adalah penentu terbesar — semakin besar, semakin mahal karena kayu
          harus lebih tua di pohon dan stok lebih terbatas. Semua dolken kami menggunakan
          panjang standar 400 cm (4 meter) sesuai kebutuhan umum pondasi cerucuk dan
          konstruksi bangunan di Indonesia.
        </p>
        <p>
          Untuk pesanan perusahaan atau partai besar (ratusan hingga ribuan batang),
          harga per batang bisa lebih murah dari daftar di atas karena kami ambil
          langsung dari pengelolaan hutan di Sumatera tanpa perantara. Hubungi kami via
          telepon atau WhatsApp untuk negosiasi.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-wood-50 py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="reveal mb-8 text-center text-2xl font-extrabold tracking-tight text-wood-900 sm:text-3xl">
        Pertanyaan Seputar Harga Kayu Dolken Per Batang
      </h2>
      <div class="space-y-4">
        {
          faq.map((f) => (
            <details class="reveal group rounded-xl border border-wood-100 bg-white p-5 open:shadow-md">
              <summary class="cursor-pointer list-none font-bold text-wood-900 marker:hidden [&::-webkit-details-marker]:hidden">
                {f.q}
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-wood-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA akhir -->
  <section class="bg-gradient-to-br from-moss-600 to-moss-700 py-14 text-center text-white">
    <div class="reveal mx-auto max-w-2xl px-4">
      <p class="text-xs font-bold uppercase tracking-widest text-moss-300">Layanan Terdekat Anda</p>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">
        Cek Harga Kayu Dolken Per Batang untuk Kota Anda
      </h2>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-white/85">
        Satu telepon, kami kabari harga per batang untuk jumlah dan diameter yang Anda
        butuhkan — plus jadwal pengiriman gratis ke lokasi.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href={`tel:${site.phones[0].tel}`}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 font-bold text-moss-700 shadow-lg transition hover:-translate-y-0.5 hover:bg-moss-50"
        >
          ☎ {site.phones[0].label}
        </a>
        <a
          href={waLink('Halo, saya mau tanya harga kayu dolken per batang.')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-wood-900 px-5 py-3 font-bold text-white shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-wood-800"
        >
          💬 WhatsApp Sekarang
        </a>
      </div>
      <p class="mt-5 text-sm text-white/80">
        Lihat seluruh area layanan di halaman
        <a href="/jual-kayu-dolken-terdekat/" class="font-bold underline decoration-moss-300 underline-offset-2 transition hover:text-moss-100">
          Jual Kayu Dolken Terdekat
        </a>.
      </p>
    </div>
  </section>
</Base>