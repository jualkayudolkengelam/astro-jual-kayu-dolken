---
import Base from '../layouts/Base.astro';
import Pricing from '../components/Pricing.astro';
import KontenTerbaru from '../components/KontenTerbaru.astro';
import { cities, regions } from '../data/cities';
import { site, waLink, rupiah, products } from '../data/site';
import { terdekatDates, formatTanggalId } from '../lib/dates.js';

const byRegion = regions.map((r) => ({
  ...r,
  cities: cities.filter((c) => c.region === r.name),
}));
const cheapest = products[0].price;

const title = 'Jual Kayu Dolken Terdekat Murah — Bayar di Tempat';
const description = `Jual kayu dolken terdekat untuk seluruh kota Pulau Jawa & Sulawesi, mulai ${rupiah(cheapest)}/batang. Diameter 4–12 cm panjang 4 m, gratis ongkir se-Jawa, bayar di tempat. Telepon ${site.phones[0].label}.`;

const whyTerdekat = [
  {
    icon: '🚚',
    title: 'Armada & Rute Harian',
    desc: 'Truk kami melintas rutin ke kota-kota besar Jawa dan Sulawesi — pesanan Anda masuk jadwal terdekat.',
  },
  {
    icon: '📦',
    title: 'Stok Selalu Siap',
    desc: 'Gudang dengan stok ribuan batang empat ukuran diameter. Tidak perlu menunggu tebang-mebal.',
  },
  {
    icon: '💰',
    title: 'Harga Pabrik',
    desc: `Langsung dari pengelolaan hutan Sumatera — mulai ${rupiah(cheapest)}/batang tanpa perantara.`,
  },
  {
    icon: '🤝',
    title: 'Bayar di Tempat',
    desc: 'Barang tiba dulu, baru bayar. Untuk perusahaan tersedia sistem invoice dan penagihan.',
  },
];

const faq = [
  {
    q: 'Apa itu jual kayu dolken terdekat?',
    a: `Maksudnya layanan pengiriman kayu dolken (gelam) dari gudang kami langsung ke lokasi Anda di kota tempat Anda berada — tanpa Anda repot mengambil sendiri. Cukup telepon ${site.phones[0].label}, sebutkan kota dan jumlahnya.`,
  },
  {
    q: 'Kota saya belum ada di daftar, bisa tetap dikirim?',
    a: 'Sangat bisa. Daftar di halaman ini adalah kota yang paling sering kami layani; untuk kota lain silakan hubungi kami — kemungkinan besar tetap masuk rute atau kami carikan solusi terbaik.',
  },
  {
    q: 'Berapa minimum pemesanan?',
    a: 'Tidak ada batasan kaku — mulai puluhan batang untuk kebutuhan rumah tangga sampai truk penuh untuk proyek konstruksi. Harga partai besar lebih murah, dibicarakan langsung.',
  },
];
---

<Base
  title={title}
  description={description}
  dateCreated={terdekatDates.created}
  dateUpdated={terdekatDates.updated}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-wood-900 text-white">
    <div
      class="absolute inset-0 opacity-20"
      style="background: radial-gradient(50rem 24rem at 80% -10%, #16a34a44, transparent), radial-gradient(40rem 22rem at 10% 120%, #c99a5f55, transparent);"
      aria-hidden="true">
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-16 text-center md:py-24">
      <p class="reveal mx-auto w-fit rounded-full border border-wood-700 bg-wood-800/60 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-wood-300">
        🚚 Melayani {cities.length}+ Kota · Jawa &amp; Sulawesi
      </p>
      <h1 class="reveal mx-auto mt-5 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-5xl">
        Jual Kayu Dolken <span class="text-moss-400">Terdekat</span> — Murah &amp; Bayar di Tempat
      </h1>
      <p class="reveal mx-auto mt-4 max-w-2xl leading-relaxed text-wood-100/90">
        "Terdekat" bukan sekadar kata — armada kami berangkat hampir setiap hari ke
        kota-kota di seluruh Indonesia bagian Jawa dan Sulawesi. Kayu dolken gelam asli
        Sumatera, kuat, lurus, dan legal resmi dinas kehutanan.
      </p>
      <p class="reveal mt-3 text-xs font-medium text-wood-400">
        Terakhir diperbarui: {formatTanggalId(terdekatDates.updated)}
      </p>
      <div class="reveal mt-7 flex flex-wrap justify-center gap-3">
        <a href={`tel:${site.phones[0].tel}`} class="inline-flex items-center gap-2 rounded-xl bg-wood-100 px-6 py-3.5 font-bold text-wood-900 shadow-lg transition hover:-translate-y-0.5 hover:bg-white">
          ☎ Telepon {site.phones[0].label}
        </a>
        <a
          href={waLink('Halo, saya mau pesan kayu dolken gelam. Mohon info harga & jadwal pengiriman ke kota saya.')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-moss-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-moss-600"
        >
          💬 WhatsApp Sekarang
        </a>
      </div>
    </div>
  </section>

  <!-- Info strip -->
  <section class="border-b border-wood-100 bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-wood-100 px-4 py-6 text-center sm:grid-cols-4 sm:divide-x">
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">Rp15rb+</p><p class="text-xs font-medium text-wood-500">per batang</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">Ø 4–12 cm</p><p class="text-xs font-medium text-wood-500">4 ukuran</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-moss-600">GRATIS</p><p class="text-xs font-medium text-wood-500">ongkir se-Jawa</p></div>
      <div class="px-2"><p class="text-xl font-extrabold text-wood-800">COD</p><p class="text-xs font-medium text-wood-500">bayar ditempat</p></div>
    </div>
  </section>

  <!-- Kenapa terdekat -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="reveal mb-8 text-center text-2xl font-extrabold tracking-tight text-wood-900 sm:text-3xl">
        Kenapa Kami Dijuluki Paling Terdekat?
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          whyTerdekat.map((w) => (
            <div class="reveal rounded-2xl border border-wood-100 bg-wood-50/60 p-6 transition hover:border-wood-300 hover:shadow-md">
              <div class="text-3xl">{w.icon}</div>
              <h3 class="mt-3 font-bold text-wood-900">{w.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-wood-600">{w.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Pricing />
  <div class="mx-auto max-w-6xl px-4">
    <KontenTerbaru mulai={3} judul="Perbaruan Lainnya" />
  </div>

  <!-- Semua area -->
  <section id="area-layanan" class="bg-wood-50 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <div class="reveal mx-auto mb-10 max-w-xl text-center">
        <h2 class="text-2xl font-extrabold tracking-tight text-wood-900 sm:text-3xl">
          Area Layanan Terdekat Kami
        </h2>
        <p class="mt-3 text-wood-600">
          Klik kota Anda untuk detail pengiriman, harga, dan dokumentasi bongkar muat.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {
          byRegion.map((r) => (
            <div class="reveal rounded-2xl border border-wood-100 bg-white p-6 shadow-sm">
              <h3 class="mb-4 font-bold text-wood-900">{r.name}</h3>
              <ul class="flex flex-wrap gap-2">
                {r.cities.map((c) => (
                  <li>
                    <a href={`/kayu-dolken-${c.slug}`} class="inline-block rounded-full border border-wood-200 bg-wood-50 px-3 py-1 text-xs font-semibold text-wood-700 transition hover:border-moss-500 hover:bg-moss-500 hover:text-white">
                      Dolken {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="reveal mb-8 text-center text-2xl font-extrabold tracking-tight text-wood-900 sm:text-3xl">
        Pertanyaan Seputar Layanan Terdekat
      </h2>
      <div class="space-y-4">
        {
          faq.map((f) => (
            <details class="reveal group rounded-xl border border-wood-100 bg-wood-50/60 p-5 open:bg-white open:shadow-md">
              <summary class="cursor-pointer list-none font-bold text-wood-900 marker:hidden [&::-webkit-details-marker]:hidden">
                {f.q}
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-wood-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA akhir -->
  <section class="bg-gradient-to-br from-moss-600 to-moss-700 py-14 text-center text-white">
    <div class="reveal mx-auto max-w-2xl px-4">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
        Kayu Dolken Terdekat Tinggal Satu Telepon
      </h2>
      <p class="mt-3 text-white/85">
        Konsultasi gratis — ceritakan kebutuhan proyek Anda, kami bantu pilih diameter yang tepat.
      </p>
      <a
        href={`tel:${site.phones[0].tel}`}
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-7 py-4 text-lg font-extrabold text-moss-700 shadow-lg transition hover:-translate-y-0.5 hover:bg-moss-50"
      >
        ☎ {site.phones[0].label}
      </a>
    </div>
  </section>
</Base>
