---
import { site, waLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-wood-200 bg-white py-12">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-lg font-extrabold text-wood-900">{site.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-wood-600">
          {site.tagline}. Melayani pemesanan kayu dolken gelam ke seluruh kota di Pulau Jawa.
        </p>
      </div>
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-wood-400">Kontak</p>
        <ul class="space-y-1.5 text-sm">
          {
            site.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`} class="text-wood-700 hover:text-wood-900">{p.label}</a>
              </li>
            ))
          }
          <li>
            <a href={waLink()} target="_blank" rel="noopener" class="font-semibold text-moss-600">WhatsApp: {site.phones[0].label}</a>
          </li>
          <li>
            <a href={site.youtube} target="_blank" rel="noopener" class="text-wood-700 hover:text-wood-900">Channel YouTube</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-wood-400">Alamat</p>
        <p class="text-sm leading-relaxed text-wood-700">{site.office.address}</p>
        <p class="mt-3 text-sm leading-relaxed text-wood-700">{site.workshop.address}</p>
      </div>
    </div>
    <hr class="my-8 border-wood-100" />
    <p class="text-center text-xs text-wood-400">
      © {year} {site.name} · {site.owner}
    </p>
  </div>
</footer>
