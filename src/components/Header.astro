---
import { site, waLink } from '../data/site';

const links = [
  { href: '/#harga', label: 'Harga' },
  { href: '/#keunggulan', label: 'Keunggulan' },
  { href: '/#galeri', label: 'Galeri' },
  { href: '/#area', label: 'Area Kirim' },
  { href: '/#kontak', label: 'Kontak' },
];
---

<header class="sticky top-0 z-40 border-b border-wood-200/60 bg-wood-50/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-wood-800 text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22V8"></path>
          <path d="M12 8c0-3.5-2.5-6-6-6H4v2c0 3.5 2.5 6 6 6h2Zm0 0c0-4 3-7 7-7h1v1.5c0 4-3 6.5-7 6.5h-1Z"></path>
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-extrabold tracking-tight text-wood-900">Jual Kayu Dolken Gelam</span>
        <span class="block text-[11px] font-medium text-wood-600">Serang · Banten</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Utama">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-wood-700 transition hover:text-wood-900">{l.label}</a>
      ))}
    </nav>

    <a
      href={`tel:${site.phones[0].tel}`}
      class="hidden rounded-full bg-wood-800 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-wood-700 sm:inline-flex"
    >
      ☎ {site.phones[0].label}
    </a>

    <details class="relative md:hidden group">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-wood-200 text-wood-800 [&::-webkit-details-marker]:hidden">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-48 rounded-xl border border-wood-100 bg-white p-2 shadow-xl">
        {links.map((l) => (
          <a href={l.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-wood-800 hover:bg-wood-100">{l.label}</a>
        ))}
        <hr class="my-2 border-wood-100" />
        <a href={waLink()} target="_blank" rel="noopener" class="block rounded-lg bg-moss-500 px-3 py-2 text-center text-sm font-semibold text-white">WhatsApp</a>
      </div>
    </details>
  </div>
</header>
