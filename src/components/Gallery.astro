---
import { Image } from 'astro:assets';

const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp}', {
    eager: true,
  })
).sort(([a], [b]) => a.localeCompare(b));

const placeholders = [
  'Stok Kayu Dolken',
  'Pengukuran Diameter',
  'Proses Muat Barang',
  'Workshop Serang',
  'Pengiriman ke Pelanggan',
  'Kayu Siap Antarkan',
];
---

<section id="galeri" class="scroll-mt-20 bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="reveal mx-auto mb-12 max-w-xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-wood-500">Galeri</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-wood-900 sm:text-4xl">
        Foto Workshop &amp; Stok Barang
      </h2>
    </div>

    {
      photos.length > 0 ? (
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
          {photos.map(([path, img]) => (
            <figure class="reveal group overflow-hidden rounded-2xl shadow-sm">
              <Image
                src={img.default ?? img}
                alt={`Foto ${path.split('/').pop()?.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ')}`}
                width={800}
                height={600}
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
          {placeholders.map((label) => (
            <div class="reveal flex aspect-[4/3] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-wood-200 bg-wood-100/50 p-4 text-center">
              <svg class="mb-2 h-8 w-8 text-wood-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 15-4.5-4.5L7 20"/></svg>
              <span class="text-xs font-semibold text-wood-400">{label}</span>
            </div>
          ))}
          <p class="col-span-full mt-4 text-center text-sm italic text-wood-400">
            Slot foto siap pakai — letakkan file foto di <code class="rounded bg-wood-100 px-1.5 py-0.5 font-mono">src/assets/gallery/</code> dan galeri terisi otomatis.
          </p>
        </div>
      )
    }
  </div>
</section>
