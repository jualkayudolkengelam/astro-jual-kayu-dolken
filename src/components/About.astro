---
import { aboutContent } from '../data/site';
---

<section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
  <div class="reveal mx-auto mb-10 max-w-xl text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-wood-500">Edukasi</p>
    <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-wood-900 sm:text-4xl">
      Mengenal Kayu Dolken Gelam Lebih Dekat
    </h2>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {
      aboutContent.map((c, i) => (
        <article class="reveal rounded-2xl border border-wood-100 bg-white p-7">
          <span class="text-sm font-black text-wood-300">0{i + 1}</span>
          <h3 class="mt-1 mb-3 text-lg font-bold text-wood-900">{c.heading}</h3>
          {c.body.map((p) => (
            <p class="mb-3 text-sm leading-relaxed text-wood-600 last:mb-0">{p}</p>
          ))}
        </article>
      ))
    }
  </div>
</section>
