---
import { features } from '../data/site';

const icons: Record<string, string> = {
  shield:
    'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  drop: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z',
  wallet:
    'M21 12V7H5a2 2 0 0 1 0-4h14v4M3 5v14a2 2 0 0 0 2 2h16v-5M18 12a2 2 0 0 0 0 4h4v-4z',
  truck:
    'M1 3h15v13H1zM16 8h4l3 3v5h-7V8zM5.5 19a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM18.5 19a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  doc: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h6',
  tag: 'M20.59 13.41L11 3.83A2 2 0 0 0 9.59 3.24H4a1 1 0 0 0-1 1v5.59c0 .53.21 1.04.59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l4.59-4.59a2 2 0 0 0 0-2.83zM7.5 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z',
};
---

<section id="keunggulan" class="scroll-mt-20 bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="reveal mx-auto mb-12 max-w-xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-wood-500">Kenapa Kami?</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-wood-900 sm:text-4xl">
        Keunggulan Kayu Dolken Gelam Kami
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="reveal group rounded-2xl border border-wood-100 bg-wood-50 p-6 transition hover:border-wood-300 hover:bg-white hover:shadow-lg">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-wood-800 text-white transition group-hover:scale-110">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[f.icon]} />
              </svg>
            </div>
            <h3 class="font-bold text-wood-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-wood-600">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
