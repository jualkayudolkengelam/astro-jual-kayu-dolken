---
import { site, waLink } from '../data/site';

const badges = ['✓ Bayar di Tempat', '✓ Gratis Ongkir', '✓ Legalitas Resmi'];
---

<section class="relative overflow-hidden bg-wood-900 text-white">
  <div
    class="absolute inset-0 opacity-20"
    style="background:
      radial-gradient(60rem 30rem at 80% -10%, #c99a5f55, transparent),
      radial-gradient(40rem 25rem at 10% 110%, #16a34a33, transparent);"
    aria-hidden="true"
  >
  </div>
  <svg class="absolute inset-x-0 bottom-0 h-14 w-full text-wood-50" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 56h1440V22c-240 18-480 26-720 12S240 4 0 22v34Z" fill="currentColor"></path>
  </svg>

  <div class="relative mx-auto max-w-6xl px-4 pb-24 pt-16 md:pt-24">
    <div class="max-w-2xl">
      <p class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-wood-400/40 bg-wood-800/60 px-3 py-1 text-xs font-semibold tracking-wide text-wood-200">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-moss-500"></span>
        STOK TERSEDIA · SIAP KIRIM SELURUH JAWA & SULAWESI
      </p>
      <h1 class="reveal text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl md:text-6xl">
        Kayu Dolken Gelam <span class="text-wood-300">Murah,</span><br />
        Sampai Baru Bayar
      </h1>
      <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-wood-100/90 md:text-lg">
        Jual kayu dolken <strong class="text-white">terdekat</strong> untuk area proyek Anda —
        melayani seluruh Pulau Jawa &amp; Sulawesi. Pondasi cerucuk terbaik dari hutan Sumatera,
        mulai <strong class="text-wood-200">Rp15.000/batang</strong> panjang 4 m.
      </p>

      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a href={`tel:${site.phones[0].tel}`} class="inline-flex items-center gap-2 rounded-xl bg-wood-100 px-6 py-3.5 font-bold text-wood-900 shadow-lg transition hover:bg-white hover:-translate-y-0.5">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Telepon Sekarang
        </a>
        <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl bg-moss-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/20 transition hover:bg-moss-600 hover:-translate-y-0.5">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24s8.24 3.7 8.24 8.24-3.7 8.24-8.24 8.24m4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.73-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28Z"/></svg>
          Pesan via WhatsApp
        </a>
      </div>

      <ul class="reveal mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-wood-200">
        {badges.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>
