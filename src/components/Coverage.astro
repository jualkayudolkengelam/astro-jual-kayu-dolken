---
import { cities, regions } from '../data/cities';

const byRegion = regions.map((r) => ({
  ...r,
  cities: cities.filter((c) => c.region === r.name),
}));
---

<section id="area" class="scroll-mt-20 bg-wood-900 py-16 text-white md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="reveal mx-auto mb-10 max-w-xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-wood-400">Jangkauan Pengiriman</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Gratis Ongkir ke {cities.length}+ Kota di Pulau Jawa
      </h2>
      <p class="mt-3 text-wood-200/80">
        Kota Anda belum tercantum? Telepon kami — kemungkinan besar tetap bisa diantar.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        byRegion.map((r) => (
          <div class="reveal rounded-2xl border border-wood-700/60 bg-wood-800/50 p-6">
            <h3 class="mb-1 font-bold text-wood-100">{r.name}</h3>
            <p class="mb-4 text-xs leading-relaxed text-wood-300/80">{r.blurb}</p>
            <ul class="flex flex-wrap gap-2">
              {r.cities.map((c) => (
                <li>
                  <a href={`/kayu-dolken-${c.slug}`} class="inline-block rounded-full border border-wood-600 px-3 py-1 text-xs font-medium text-wood-200 transition hover:border-moss-500 hover:bg-moss-500 hover:text-white">
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
